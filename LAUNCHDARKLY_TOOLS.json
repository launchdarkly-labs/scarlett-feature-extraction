        "required": ["transcript_id", "customer_company_name", "salesperson_name", "call_number", "variation_used", "call_date", "call_duration_minutes", "call_category", "deal_stage", "customer_size", "industry", "estimated_deal_value", "overall_sentiment_score", "sentiment_about_product", "sentiment_about_pricing", "customer_engagement_score", "urgency_score", "budget_confidence_score", "next_steps_defined", "competitors_mentioned", "decision_makers_present", "classification_model_used", "extraction_model_used", "extraction_timestamp", "technical_requirements", "architecture_discussed", "deployment_model", "technical_fit_score", "technical_risk_score"]
      }
    }
  },


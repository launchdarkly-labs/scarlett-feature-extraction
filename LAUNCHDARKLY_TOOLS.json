          "success_stories": {"type": "array", "items": {"type": "string"}, "description": "Customer success stories"},
          "roi_discussed": {"type": "boolean", "description": "Whether ROI was discussed"},
          "roi_metrics": {"type": "string", "description": "ROI metrics shared by customer"},
          "referral_potential": {"type": "boolean", "description": "Whether customer could provide referrals"}
        },
        "required": ["transcript_id", "customer_company_name", "salesperson_name", "call_number", "variation_used", "call_date", "call_duration_minutes", "call_category", "deal_stage", "customer_size", "industry", "estimated_deal_value", "overall_sentiment_score", "sentiment_about_product", "sentiment_about_pricing", "customer_engagement_score", "urgency_score", "budget_confidence_score", "next_steps_defined", "competitors_mentioned", "decision_makers_present", "classification_model_used", "extraction_model_used", "extraction_timestamp", "account_health_score", "satisfaction_score", "product_adoption_level", "renewal_likelihood"]
      }
    }
  },

  "usage_instructions": {
    "step_1": "Go to LaunchDarkly → AI Configs",
    "step_2_classification": "Create AI Config named 'transcript-classification' and paste the 'classification_tool' above into the tools array",
    "step_3_extraction": "Create AI Config named 'sales-transcript-extraction' with 6 variations",
    "step_4_variation_a": "For Variation A, paste 'variation_a_prospecting' tool (remember to include all 33 core fields + 10 prospecting fields)",
    "step_5_variation_b": "For Variation B, paste 'variation_b_discovery' tool (33 core + 15 discovery fields)",
    "step_6_variation_c": "For Variation C, paste 'variation_c_demo' tool (33 core + 25 demo fields)",

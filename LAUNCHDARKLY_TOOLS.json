{
  "description": "Copy-paste tool schemas for LaunchDarkly AI Configs",
  "note": "These JSON Schemas define the structured outputs for each variation. Paste the tool object into the 'tools' array in LaunchDarkly AI Config UI.",

  "classification_tool": {
    "type": "function",
    "function": {
      "name": "classify_transcript",
      "description": "Classify sales call transcript and determine routing variation",
      "parameters": {
        "type": "object",
        "properties": {
          "call_category": {
            "type": "string",
            "enum": ["prospecting_outbound", "early_stage_post_rko", "further_stages_connected", "solutions_engineering", "customer_success", "product_research", "other"],
            "description": "Primary category of the call"
          },
          "call_stage": {
            "type": "string",
            "description": "Stage in the sales process (discovery, qualification, demo, proposal, negotiation, closing, post_sale)"
          },
          "primary_variation": {
            "type": "string",
            "enum": ["A", "B", "C", "D", "E", "F"],
            "description": "Which extraction variation to use (A=prospecting, B=discovery, C=demo, D=proposal, E=technical, F=customer success)"
          },
          "is_multi_faceted": {
            "type": "boolean",
            "description": "Whether this call covers multiple areas"
          },
          "secondary_variation": {
            "type": "string",
            "enum": ["A", "B", "C", "D", "E", "F"],
            "description": "Optional secondary variation if call is multi-faceted"
          },
          "estimated_deal_value": {
            "type": "integer",
            "description": "Estimated deal value in USD"
          },
          "customer_segment": {
            "type": "string",
            "enum": ["startup", "small", "medium", "enterprise", "large_enterprise"],
            "description": "Company size classification"
          },
          "industry": {
            "type": "string",
            "enum": ["technology", "finance", "healthcare", "retail", "manufacturing", "education", "government", "other"],
            "description": "Industry vertical"
          },
          "region": {
            "type": "string",
            "enum": ["us_east", "us_west", "emea", "apac", "latam", "unknown"],
            "description": "Geographic region"
          },
          "complexity_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Complexity of the call from 0 (simple) to 1 (very complex)"
          },
          "call_duration_estimate": {
            "type": "string",
            "enum": ["under_5_min", "5_15_min", "15_30_min", "30_60_min", "over_60_min"],
            "description": "Estimated call duration bucket"
          },
          "has_multiple_stakeholders": {
            "type": "boolean",
            "description": "Whether multiple stakeholders were on the call"
          },
          "has_technical_discussion": {
            "type": "boolean",
            "description": "Whether technical topics were discussed"
          },
          "has_competitors_mentioned": {
            "type": "boolean",
            "description": "Whether competitors were mentioned"
          },
          "has_pricing_discussion": {
            "type": "boolean",
            "description": "Whether pricing was discussed"
          }
        },
        "required": ["call_category", "call_stage", "primary_variation", "estimated_deal_value", "customer_segment", "industry", "complexity_score", "call_duration_estimate", "has_multiple_stakeholders", "has_technical_discussion", "has_competitors_mentioned", "has_pricing_discussion"]
      }
    }
  },

  "core_fields_note": "These 33 core fields MUST be included in ALL variation tools (A-F) for consistent reporting",

  "core_fields_schema": {
    "transcript_id": {"type": "string", "description": "Unique identifier for this call transcript"},
    "customer_company_name": {"type": "string", "description": "Name of the customer company"},
    "salesperson_name": {"type": "string", "description": "Name of the salesperson on the call"},
    "call_number": {"type": "integer", "description": "Sequence number for this customer (1st call, 2nd call, etc.)"},
    "variation_used": {"type": "string", "description": "Variation letter used for extraction (A, B, C, D, E, F)"},
    "call_date": {"type": "string", "description": "Date of the call in ISO format (YYYY-MM-DD)"},
    "call_duration_minutes": {"type": "number", "description": "Duration of the call in minutes"},
    "call_time": {"type": "string", "description": "Time of the call (HH:MM in 24h format)"},
    "call_category": {"type": "string", "description": "Category from classification step"},
    "is_multi_faceted": {"type": "boolean", "description": "Whether this call was classified as multi-faceted"},
    "deal_stage": {"type": "string", "enum": ["discovery", "qualification", "demo", "proposal", "negotiation", "closing", "post_sale"], "description": "Current stage in the sales funnel"},
    "customer_size": {"type": "string", "enum": ["startup", "small", "medium", "enterprise", "large_enterprise"], "description": "Size classification of the customer company"},
    "industry": {"type": "string", "enum": ["technology", "finance", "healthcare", "retail", "manufacturing", "education", "government", "other"], "description": "Industry vertical"},
    "estimated_deal_value": {"type": "integer", "description": "Estimated or actual deal value in USD"},
    "overall_sentiment_score": {"type": "number", "minimum": -1, "maximum": 1, "description": "Overall customer sentiment from -1 (very negative) to +1 (very positive)"},
    "sentiment_about_product": {"type": "number", "minimum": -1, "maximum": 1, "description": "Sentiment about our product/solution from -1 to +1"},
    "sentiment_about_pricing": {"type": "number", "minimum": -1, "maximum": 1, "description": "Sentiment about pricing from -1 (too expensive) to +1 (good value)"},
    "sentiment_about_competitors": {"type": "number", "minimum": -1, "maximum": 1, "description": "Sentiment about competitor solutions from -1 to +1"},
    "sentiment_about_market_conditions": {"type": "number", "minimum": -1, "maximum": 1, "description": "Sentiment about economy/market conditions from -1 (pessimistic) to +1 (optimistic)"},
    "sentiment_about_current_solution": {"type": "number", "minimum": -1, "maximum": 1, "description": "Sentiment about their current solution from -1 (very unhappy) to +1 (very satisfied)"},
    "customer_engagement_score": {"type": "number", "minimum": 0, "maximum": 1, "description": "Engagement from 0 (disengaged) to 1 (highly engaged)"},
    "urgency_score": {"type": "number", "minimum": 0, "maximum": 1, "description": "Urgency from 0 (no urgency) to 1 (immediate need)"},
    "budget_confidence_score": {"type": "number", "minimum": 0, "maximum": 1, "description": "Confidence budget is available from 0 (no budget) to 1 (confirmed budget)"},
    "next_steps_defined": {"type": "boolean", "description": "Whether clear next steps were established"},
    "next_steps_description": {"type": "string", "description": "Description of the agreed next steps"},
    "timeline_mentioned": {"type": "string", "description": "Timeline mentioned by customer (e.g., 'Q1 2024', 'next month')"},
    "decision_timeline_urgent": {"type": "boolean", "description": "Whether the decision timeline is urgent (< 30 days)"},
    "competitors_mentioned": {"type": "boolean", "description": "Whether any competitors were mentioned"},
    "competitor_names": {"type": "array", "items": {"type": "string"}, "description": "Names of competitors mentioned"},
    "churn_risk_signals": {"type": "boolean", "description": "Whether any churn/at-risk signals were detected"},
    "decision_makers_present": {"type": "boolean", "description": "Whether decision makers were present on the call"},
    "total_participants": {"type": "integer", "description": "Total number of participants on the call"},
    "classification_model_used": {"type": "string", "description": "Model used for classification"},
    "extraction_model_used": {"type": "string", "description": "Model used for extraction"},
    "extraction_timestamp": {"type": "string", "description": "ISO timestamp when extraction was performed"}
  },

  "variation_a_prospecting": {
    "type": "function",
    "function": {
      "name": "extract_prospecting_features",
      "description": "Extract features from prospecting/TOFU cold outreach calls",
      "parameters": {
        "type": "object",
        "properties": {
          "call_outcome": {"type": "string", "enum": ["connected", "voicemail", "no_answer", "gatekeeper", "wrong_number", "callback_scheduled"], "description": "Outcome of the prospecting call"},
          "gatekeeper_encountered": {"type": "boolean", "description": "Whether a gatekeeper was encountered"},
          "reached_target_contact": {"type": "boolean", "description": "Whether the target contact was reached"},
          "interest_level": {"type": "string", "enum": ["none", "low", "medium", "high"], "description": "Level of interest expressed"},
          "pain_point_mentioned": {"type": "boolean", "description": "Whether a pain point was mentioned"},
          "pain_point_description": {"type": "string", "description": "Description of the pain point if mentioned"},
          "budget_indication": {"type": "string", "description": "Any indication of budget or budget range"},
          "callback_scheduled": {"type": "boolean", "description": "Whether a callback was scheduled"},
          "callback_date": {"type": "string", "description": "Date/time of scheduled callback"},
          "email_sent": {"type": "boolean", "description": "Whether a follow-up email was promised/sent"}
        },
        "required": ["transcript_id", "customer_company_name", "salesperson_name", "call_number", "variation_used", "call_date", "call_duration_minutes", "call_category", "deal_stage", "customer_size", "industry", "estimated_deal_value", "overall_sentiment_score", "sentiment_about_product", "sentiment_about_pricing", "customer_engagement_score", "urgency_score", "budget_confidence_score", "next_steps_defined", "competitors_mentioned", "decision_makers_present", "classification_model_used", "extraction_model_used", "extraction_timestamp", "call_outcome", "gatekeeper_encountered", "reached_target_contact", "interest_level", "pain_point_mentioned"]
      }
    }
  },

  "variation_b_discovery": {
    "type": "function",
    "function": {
      "name": "extract_discovery_features",
      "description": "Extract features from discovery/qualification calls using BANT framework",
      "parameters": {
        "type": "object",
        "properties": {
          "budget_confirmed": {"type": "boolean", "description": "Whether budget has been confirmed (B in BANT)"},
          "budget_amount": {"type": "integer", "description": "Confirmed or estimated budget amount in USD"},
          "budget_timeframe": {"type": "string", "description": "Timeframe for budget availability"},
          "authority_level": {"type": "string", "enum": ["champion", "influencer", "decision_maker", "blocker", "unknown"], "description": "Authority level of contact (A in BANT)"},
          "decision_process_explained": {"type": "boolean", "description": "Whether decision-making process was explained"},
          "need_validated": {"type": "boolean", "description": "Whether customer need has been validated (N in BANT)"},
          "pain_points": {"type": "array", "items": {"type": "string"}, "description": "List of customer pain points"},
          "current_solution": {"type": "string", "description": "What solution they currently use (if any)"},
          "limitations_current_solution": {"type": "string", "description": "Limitations of their current solution"},
          "timeline_decision": {"type": "string", "description": "Timeline for making a decision (T in BANT)"},
          "timeline_implementation": {"type": "string", "description": "Timeline for implementation"},
          "success_criteria": {"type": "string", "description": "What success looks like for the customer"},
          "stakeholders_involved": {"type": "array", "items": {"type": "string"}, "description": "List of stakeholders involved in decision"},
          "qualification_score": {"type": "number", "minimum": 0, "maximum": 1, "description": "BANT qualification score 0-1"},
          "recommended_next_step": {"type": "string", "description": "Recommended next step based on qualification"}
        },
        "required": ["transcript_id", "customer_company_name", "salesperson_name", "call_number", "variation_used", "call_date", "call_duration_minutes", "call_category", "deal_stage", "customer_size", "industry", "estimated_deal_value", "overall_sentiment_score", "sentiment_about_product", "sentiment_about_pricing", "customer_engagement_score", "urgency_score", "budget_confidence_score", "next_steps_defined", "competitors_mentioned", "decision_makers_present", "classification_model_used", "extraction_model_used", "extraction_timestamp", "budget_confirmed", "authority_level", "need_validated", "pain_points", "qualification_score"]
      }
    }
  },

  "variation_c_demo": {
    "type": "function",
    "function": {
      "name": "extract_demo_features",
      "description": "Extract features from product demo and presentation calls",
      "parameters": {
        "type": "object",
        "properties": {
          "features_demonstrated": {"type": "array", "items": {"type": "string"}, "description": "List of features shown in demo"},
          "use_cases_discussed": {"type": "array", "items": {"type": "string"}, "description": "Use cases discussed"},
          "customer_wow_moments": {"type": "array", "items": {"type": "string"}, "description": "Features that impressed the customer"},
          "questions_asked": {"type": "integer", "description": "Number of questions asked by customer"},
          "technical_fit_score": {"type": "number", "minimum": 0, "maximum": 1, "description": "How well solution fits technically 0-1"},
          "integration_requirements": {"type": "array", "items": {"type": "string"}, "description": "Integration requirements mentioned"},
          "technical_concerns": {"type": "array", "items": {"type": "string"}, "description": "Technical concerns raised"},
          "competitive_comparison_requested": {"type": "boolean", "description": "Whether customer asked to compare with competitors"},
          "competitors_compared": {"type": "array", "items": {"type": "string"}, "description": "Competitors compared to"},
          "trial_poc_requested": {"type": "boolean", "description": "Whether trial or POC was requested"},
          "trial_start_date": {"type": "string", "description": "Proposed trial start date"},
          "trial_duration": {"type": "string", "description": "Proposed trial duration"},
          "demo_effectiveness_score": {"type": "number", "minimum": 0, "maximum": 1, "description": "How effective was the demo 0-1"},
          "customer_participation_level": {"type": "string", "enum": ["passive", "engaged", "highly_engaged"], "description": "Customer participation level"},
          "screen_sharing_by_customer": {"type": "boolean", "description": "Whether customer shared their screen"},
          "follow_up_demo_needed": {"type": "boolean", "description": "Whether additional demo is needed"},
          "customization_requests": {"type": "array", "items": {"type": "string"}, "description": "Customization requests"},
          "pricing_discussed": {"type": "boolean", "description": "Whether pricing was discussed"},
          "pricing_model_explained": {"type": "string", "description": "Pricing model explained (if any)"},
          "pricing_concerns": {"type": "array", "items": {"type": "string"}, "description": "Pricing concerns raised"},
          "decision_makers_on_demo": {"type": "array", "items": {"type": "string"}, "description": "Decision makers present"},
          "technical_team_present": {"type": "boolean", "description": "Whether technical team was present"},
          "objections_raised": {"type": "array", "items": {"type": "string"}, "description": "Objections raised during demo"},
          "objections_resolved": {"type": "boolean", "description": "Whether objections were resolved"},
          "proposal_requested": {"type": "boolean", "description": "Whether customer requested a proposal"}
        },
        "required": ["transcript_id", "customer_company_name", "salesperson_name", "call_number", "variation_used", "call_date", "call_duration_minutes", "call_category", "deal_stage", "customer_size", "industry", "estimated_deal_value", "overall_sentiment_score", "sentiment_about_product", "sentiment_about_pricing", "customer_engagement_score", "urgency_score", "budget_confidence_score", "next_steps_defined", "competitors_mentioned", "decision_makers_present", "classification_model_used", "extraction_model_used", "extraction_timestamp", "features_demonstrated", "use_cases_discussed", "technical_fit_score", "demo_effectiveness_score"]
      }
    }
  },

  "variation_d_proposal": {
    "type": "function",
    "function": {
      "name": "extract_proposal_features",
      "description": "Extract features from proposal review and negotiation calls",
      "parameters": {
        "type": "object",
        "properties": {
          "proposal_sent_date": {"type": "string", "description": "Date proposal was sent"},
          "proposal_reviewed": {"type": "boolean", "description": "Whether customer reviewed the proposal"},
          "pricing_discussed": {"type": "boolean", "description": "Whether pricing was discussed"},
          "proposed_contract_value": {"type": "integer", "description": "Proposed contract value in USD"},
          "contract_term": {"type": "string", "description": "Contract term (e.g., '1 year', '3 years')"},
          "pricing_objections": {"type": "array", "items": {"type": "string"}, "description": "Pricing objections raised"},
          "discount_requested": {"type": "boolean", "description": "Whether discount was requested"},
          "discount_amount_requested": {"type": "number", "description": "Discount amount/percentage requested"},
          "discount_offered": {"type": "boolean", "description": "Whether discount was offered"},
          "negotiation_points": {"type": "array", "items": {"type": "string"}, "description": "Key negotiation points"},
          "terms_negotiated": {"type": "array", "items": {"type": "string"}, "description": "Specific terms being negotiated"},
          "procurement_process_stage": {"type": "string", "description": "Where in procurement process"},
          "legal_review_required": {"type": "boolean", "description": "Whether legal review is required"},
          "legal_concerns": {"type": "array", "items": {"type": "string"}, "description": "Legal concerns raised"},
          "security_review_required": {"type": "boolean", "description": "Whether security review is required"},
          "budget_approved": {"type": "boolean", "description": "Whether budget has been approved"},
          "approval_chain": {"type": "array", "items": {"type": "string"}, "description": "Approval chain/stakeholders"},
          "close_probability": {"type": "number", "minimum": 0, "maximum": 1, "description": "Probability of closing 0-1"},
          "expected_close_date": {"type": "string", "description": "Expected close date"},
          "blockers_to_close": {"type": "array", "items": {"type": "string"}, "description": "Blockers preventing close"}
        },
        "required": ["transcript_id", "customer_company_name", "salesperson_name", "call_number", "variation_used", "call_date", "call_duration_minutes", "call_category", "deal_stage", "customer_size", "industry", "estimated_deal_value", "overall_sentiment_score", "sentiment_about_product", "sentiment_about_pricing", "customer_engagement_score", "urgency_score", "budget_confidence_score", "next_steps_defined", "competitors_mentioned", "decision_makers_present", "classification_model_used", "extraction_model_used", "extraction_timestamp", "proposal_reviewed", "pricing_discussed", "close_probability"]
      }
    }
  },


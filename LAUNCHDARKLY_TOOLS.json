          "infrastructure": {"type": "array", "items": {"type": "string"}, "description": "Infrastructure components (AWS, GCP, Azure, Kubernetes, etc.)"},
          "integration_points": {"type": "array", "items": {"type": "string"}, "description": "Systems to integrate with"},
          "api_requirements": {"type": "boolean", "description": "Whether API requirements were discussed"},
          "data_migration_needed": {"type": "boolean", "description": "Whether data migration is needed"},
          "data_volume": {"type": "string", "description": "Volume of data to migrate/handle"},

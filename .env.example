# LaunchDarkly Configuration
LAUNCHDARKLY_SDK_KEY=sdk-xxxxx-xxxxx-xxxxx
LD_API_KEY=api-xxxxx-xxxxx-xxxxx           # Only needed for bootstrap script
LD_PROJECT_KEY=your-project-key            # Only needed for bootstrap script

# Vercel AI Gateway Authentication (choose one)
# Option 1: API key from the Vercel dashboard (AI Gateway > API keys)
AI_GATEWAY_API_KEY=vck_xxxxx

# Option 2: OIDC token, only if you have a linked Vercel project.
# Locally it takes precedence over the API key, so leave it commented out otherwise.
# VERCEL_OIDC_TOKEN=eyJhbGc...              # Get via: npx vercel env pull

# Optional: Redis Cache (if using docker-compose redis service)
# REDIS_URL=redis://redis:6379

# Optional: ML Model Configuration
# MODEL_PATH=./models/deal_model.pkl
# ENABLE_ML_PREDICTIONS=true
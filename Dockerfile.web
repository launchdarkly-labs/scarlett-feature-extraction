# Multi-purpose Node.js + Python image for Next.js with ML capabilities
FROM node:18-slim

# Install Python and build dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create symlinks for python commands
RUN ln -s /usr/bin/python3 /usr/bin/python

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL Node dependencies (including devDependencies for build)
# Use --legacy-peer-deps due to version conflict with ai package
RUN npm ci --legacy-peer-deps

# Copy application code
COPY . .

# Install Python ML dependencies globally (no venv needed in Docker)
# Use --break-system-packages since we're in an isolated container
RUN pip3 install --break-system-packages --upgrade pip && \
    pip3 install --break-system-packages \
        scikit-learn==1.3.0 \
        catboost==1.2.0 \
        pandas==2.0.3 \
        numpy==1.24.3 \
        joblib==1.3.1

# Build Next.js application
RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "dev"]